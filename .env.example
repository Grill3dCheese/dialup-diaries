NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dialup_diaries
SESSION_SECRET=replace-with-at-least-32-characters!!
TRUST_PROXY=0
ADMIN_USERNAMES=

# Web Push (VAPID). Generate locally, then copy into this file or your host's secret store:
#   npx web-push generate-vapid-keys --json
#   npm run vapid:generate
# Keep VAPID_PRIVATE_KEY on the server only. Never commit it or send it to the browser.
# VAPID_EMAIL_SUBJECT must be a mailto: address or https: contact URL (RFC 8292).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL_SUBJECT=
