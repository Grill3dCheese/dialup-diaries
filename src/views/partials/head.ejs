<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Dialup Diaries — thoughtful posts, tiny joys, and your own corner of the web.">
  <meta name="theme-color" content="#fff6d8">
  <meta name="color-scheme" content="light dark">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content="Dialup Diaries">
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="apple-touch-icon" href="/art/dialup-diaries-logo.jpeg">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <% if (locals.vapidPublicKey) { %>
  <meta name="vapid-public-key" content="<%= vapidPublicKey %>">
  <% } %>
  <title><%= title %> · Dialup Diaries</title>
  <script src="/theme-init.js"></script>
  <link rel="stylesheet" href="/styles/main.css">
  <script type="module" src="/app.js"></script>
</head>

<body>
  <a class="skip-link" href="#main">Skip to the good stuff</a>
  <div class="ambient-grid" aria-hidden="true"></div>
  <div class="halloween-art" aria-hidden="true">
    <img class="halloween-art__pumpkin" src="/art/pumpkin-face5-white.svg" alt="">
    <img class="halloween-art__skull" src="/art/white-ghost-boo.svg" alt="">
    <img class="halloween-art__ghosts" src="/art/skelton-peace-white.svg" alt="">
    <img class="halloween-art__skull-white" src="/art/ghost-white.svg" alt="">
    <img class="halloween-art__tombstone" src="/art/skull-white.webp" alt="">
    <img class="halloween-art__witch-hat" src="/art/pumpkin-face3-white.svg" alt="">
    <img class="halloween-art__cauldron" src="/art/pumpkin-face5-orange.svg" alt="">
    <img class="halloween-art__bats" src="/art/poison-apple-bw.svg" alt="">
    <img class="halloween-art__cobweb halloween-art__cobweb--left" src="/art/spiderweb-white.svg" alt="">
    <img class="halloween-art__cobweb halloween-art__cobweb--right" src="/art/spiderweb-white.svg" alt="">
  </div>
  <header class="site-header">
    <div class="header-inner">
      <a class="brand" href="/" aria-label="Dialup Diaries home">
        <span class="brand-orbit" aria-hidden="true">✦</span>
        <span>
          <strong>Dialup</strong>
          <em>Diaries</em>
        </span>
      </a>
      <nav class="main-nav" aria-label="Main navigation">
        <a class="<%= path === '/' ? 'is-current' : '' %>" href="/">
          <span aria-hidden="true"><img class="open-book-icon" src="/art/open-book.svg" alt=""></span> Timeline
        </a>
        <a class="nav-changelog <%= path.startsWith('/changelog') ? 'is-current' : '' %>" href="/changelog">
          <span aria-hidden="true">✎</span> Changelog
        </a>
        <% if (currentUser) { %>
        <a class="<%= path.startsWith('/u/') ? 'is-current' : '' %>" href="/u/<%= currentUser.username %>">
          <span aria-hidden="true"><img class="user-personal-page" src="/art/user-personal-page.svg" alt=""></span> My page
        </a>
        <form action="/logout" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="nav-button" type="submit">Sign out</button>
        </form>
        <% } else { %>
        <a href="/login">Sign in</a>
        <a class="nav-cta" href="/register">Make your page</a>
        <% } %>
        <button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle color theme" aria-pressed="false" title="Toggle color theme">
          <span class="theme-toggle__track" aria-hidden="true">
            <svg class="theme-toggle__moon" viewBox="0 0 24 24">
              <path d="M20 15.1A8.5 8.5 0 0 1 8.9 4a8.5 8.5 0 1 0 11.1 11.1Z" />
              <path d="m15.5 3 .5 1.2 1.2.5-1.2.5-.5 1.2-.5-1.2-1.2-.5 1.2-.5Z" />
            </svg>
            <svg class="theme-toggle__sun" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="3.5" />
              <path d="M12 1.5v3M12 19.5v3M1.5 12h3M19.5 12h3M4.6 4.6l2.1 2.1M17.3 17.3l2.1 2.1M19.4 4.6l-2.1 2.1M6.7 17.3l-2.1 2.1" />
            </svg>
            <span class="theme-toggle__thumb"></span>
          </span>
        </button>
      </nav>
    </div>
    <div class="status-strip">
      <% if (currentUser) { %>
      <span class="status-led-connected" aria-hidden="true"></span>
      <span>CONNECTED AT 56K</span>
      <% } else { %>
      <span class="status-led-disconnected" aria-hidden="true"></span>
      <span>DISCONNECTED</span>
      <% } %>
      <span class="status-strip__tagline" aria-hidden="true">·</span>
      <span class="status-strip__tagline">A DIALUP DEITY, IF YOU WILL ^_^</span>
      <button class="pager-toggle" type="button" data-push-toggle hidden aria-pressed="false" aria-label="Turn on guestbook pager notifications" title="Turn on guestbook pager notifications">
        <span class="pager-toggle__led" aria-hidden="true"></span>
        <span data-push-toggle-label>PAGER OFF</span>
      </button>
      <span class="status-time"><%= new Date().toLocaleDateString('en', { weekday: 'long', month: 'short', day: 'numeric' }) %></span>
    </div>
  </header>

  <aside class="pager-hint" data-pager-hint hidden>
    <span class="pager-hint__label">pager.exe</span>
    <p data-pager-hint-body></p>
  </aside>

  <% if (flash) { %>
  <div class="flash flash--<%= flash.kind %>" role="status" data-flash>
    <span class="flash__glyph" aria-hidden="true"><%= flash.kind === 'success' ? '✦' : '!' %></span>
    <span class="flash__message"><%= flash.message %></span>
    <button type="button" aria-label="Dismiss message" data-dismiss>×</button>
  </div>
  <% } %>