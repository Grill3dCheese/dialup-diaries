{
  "name": "dialup-diaries",
  "version": "1.0.0",
  "description": "A secure, server-rendered social blog with a nostalgic early-web soul.",
  "private": true,
  "main": "dist/server.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build:theme": "esbuild src/client/theme-init.js --bundle --minify --format=iife --target=es2022 --outfile=public/theme-init.js",
    "build:client": "npm run build:theme && esbuild src/client/app.js --bundle --minify --sourcemap --format=esm --target=es2022 --outfile=public/app.js",
    "build:server": "tsc -p tsconfig.build.json",
    "build": "npm run build:client && npm run build:server",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "keywords": [
    "blog",
    "social",
    "express",
    "postgresql"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "compression": "^1.8.1",
    "connect-pg-simple": "^10.0.0",
    "cookie": "^2.0.1",
    "drizzle-orm": "^0.45.2",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "motion": "^12.43.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/compression": "^1.8.1",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.3",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
